# net/samba422 for keelNAS (docs/05 section 11). Off: what a file server on keelOS does not use
# and what pulls python, avahi/dbus/X11 and gamin into the image. Zeroconf is mDNSResponder, not
# none: the port refuses FRUIT (vfs_fruit for macOS) without a zeroconf choice, and
# mDNSResponder needs nothing else (avahi brings dbus, glib, libX11).
_OPTIONS_READ=samba422
OPTIONS_FILE_UNSET+=AD_DC
OPTIONS_FILE_UNSET+=PYTHON3
OPTIONS_FILE_UNSET+=FAM
OPTIONS_FILE_UNSET+=DOCS
OPTIONS_FILE_UNSET+=MANPAGES
OPTIONS_FILE_UNSET+=AVAHI
OPTIONS_FILE_UNSET+=GPGME
OPTIONS_FILE_UNSET+=CUPS
OPTIONS_FILE_UNSET+=ZEROCONF_NONE
OPTIONS_FILE_SET+=MDNSRESPONDER
OPTIONS_FILE_SET+=BUNDLED_TALLOC
OPTIONS_FILE_SET+=BUNDLED_TDB
OPTIONS_FILE_SET+=BUNDLED_TEVENT
OPTIONS_FILE_SET+=BUNDLED_CMOCKA
OPTIONS_FILE_SET+=ADS
OPTIONS_FILE_SET+=LDAP
OPTIONS_FILE_SET+=FRUIT
OPTIONS_FILE_SET+=QUOTAS
OPTIONS_FILE_SET+=SYSLOG
OPTIONS_FILE_SET+=UTMP
OPTIONS_FILE_SET+=PROFILE
OPTIONS_FILE_SET+=GSSAPI_BUILTIN
